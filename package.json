{
  "name": "vanya",
  "version": "0.1.0",
  "description": "A modular AI assistant framework with skills system - inspired by Clawdbot",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown src/index.ts --format esm",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["ai", "assistant", "telegram", "bot", "grammy"],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "grammy": "^1.39.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "tsdown": "^0.2.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
